=== common headers
header: Cross-Origin-Embedder-Policy: require-corp
header: Cross-Origin-Opener-Policy: same-origin
header: Cross-Origin-Resource-Policy: same-origin
header: Origin-Agent-Cluster: ?1
header: Referrer-Policy: no-referrer
header: Vary: Accept-Encoding
header: X-Content-Type-Options: nosniff
header: X-Dns-Prefetch-Control: off
header: X-Download-Options: noopen
header: X-Frame-Options: SAMEORIGIN
header: X-Permitted-Cross-Domain-Policies: none
header: X-Ratelimit-Limit: 1000
header: X-Ratelimit-Remaining: <varies>
header: X-Ratelimit-Reset: <varies>
header: X-Request-Id: <varies>
header: X-Xss-Protection: 0

=== GET /livez (no token)
status: 200
header: Content-Type: text/plain; charset=utf-8
body:
OK

=== GET /readyz (no token)
status: 200
header: Content-Type: text/plain; charset=utf-8
body:
OK

=== GET /startupz (no token)
status: 200
header: Content-Type: text/plain; charset=utf-8
body:
OK

=== GET /v1/config
status: 200
header: Content-Type: application/json; charset=utf-8
body:
{
  "api_version": "v1",
  "config": {
    "filter_desc": "Checking all containers (except explicitly disabled with label)",
    "scope": "",
    "monitor_only": false,
    "cleanup": true,
    "no_pull": false,
    "no_restart": false,
    "rolling_restart": false,
    "include_stopped": true,
    "include_restarting": false,
    "lifecycle_hooks": true,
    "label_enable": false,
    "git_enable": false
  },
  "timestamp": "<timestamp>"
}

